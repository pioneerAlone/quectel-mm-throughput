#!/usr/bin/env bash
# Mock mmcli for tests. Reads fixture files based on the request type.
#
# Recognized invocations:
#   mmcli --version
#   mmcli --output-keyvalue -L
#   mmcli --output-keyvalue -m 0 -b
#
# The MMCLI_FIXTURE_VERSION env var selects which fixture set to use.
# Default: 1.22.0

FIXTURE_VERSION="${MMCLI_FIXTURE_VERSION:-1.22.0}"
FIXTURE_DIR="${MMCLI_FIXTURE_DIR:-$(dirname "$(readlink -f "$0")")/..}"

case "$*" in
    "--version")
        echo "mmcli ${FIXTURE_VERSION}"
        ;;
    "--output-keyvalue -L")
        cat "${FIXTURE_DIR}/fixtures/mmcli-${FIXTURE_VERSION}-L.out"
        ;;
    "--output-keyvalue -m 0 -b "*)
        cat "${FIXTURE_DIR}/fixtures/mmcli-${FIXTURE_VERSION}-bearer.out"
        ;;
    "-m "*"--create-bearer="*)
        # Mock creation: just emit a new bearer path
        echo "Bearer '/org/freedesktop/ModemManager1/Bearer/1' successfully created"
        ;;
    "--output-keyvalue -m 0 -b")
        cat "${FIXTURE_DIR}/fixtures/mmcli-${FIXTURE_VERSION}-bearer.out"
        ;;
    *)
        echo "mock-mmcli: unknown invocation: $*" >&2
        exit 1
        ;;
esac